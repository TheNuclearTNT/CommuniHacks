# Database connection string (TigerData / TimescaleDB / Postgres)
# Leave blank locally to use embedded PGlite Postgres fallback automatically
DATABASE_URL=postgres://postgres:postgres@localhost:5432/langs_safereport

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs Speech-to-Text API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Set to true to return deterministic mock AI responses for offline demos
USE_MOCK_AI=true

