# Database connection string (TigerData / TimescaleDB / Postgres)
# Leave blank locally to use embedded PGlite Postgres fallback automatically
DATABASE_URL=postgres://postgres:postgres@localhost:5432/langs_safereport

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ElevenLabs API key. Powers the assistant's spoken questions (text-to-speech)
# and turns recordings into text (speech-to-text).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: which ElevenLabs voice speaks. The default is the premade voice
# "Sarah". Free plans can only use premade voices through the API; library
# voices return a 402 error.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Voice is separate from the AI. With a real key above, voice is live even when
# USE_MOCK_AI=true. Set this to true to turn voice off (the assistant is silent
# and recordings return a canned demo story).
# USE_MOCK_VOICE=true

# Set to true to return deterministic mock AI responses for offline demos
USE_MOCK_AI=true

# Allow x-seed-time header & POST /api/dev/reset-demo for back-dating seed data
ALLOW_SEED_TIME=true


